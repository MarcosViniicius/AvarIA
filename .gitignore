# ============================================
# PYTHON & FLASK
# ============================================

# Python compiled files
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# Flask
instance/
.webassets-cache

# ============================================
# IDEs & EDITORS
# ============================================

.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ============================================
# SISTEMA OPERACIONAL
# ============================================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
._*

# Linux
.directory
*~

# ============================================
# TEMPORÁRIOS & LOGS
# ============================================

*.tmp
*.temp
*.log
*.bak
*.backup
*.old
*.orig
.cancel_processing
*.opus
.agent
.ruff_cache

# ============================================
# 🔒 SEGURANÇA (CRÍTICO)
# ============================================

# Configuração com API keys sensíveis. O padrão sem barra inicial casa em
# QUALQUER nível — inclusive dentro do pacote (avariaia/config/config.json),
# que já apareceu por engano quando paths.py apontava para o lugar errado.
config.json
!config/config.example.json

# Variáveis de ambiente
.env
.env.*
!.env.example

# Certificados e chaves
*.key
*.pem
*.p12
*.pfx
*.api-key
secrets.json
.secrets
credentials.json

# ============================================
# 📁 DADOS DO PROJETO (CRÍTICO)
# ============================================

# Dados gerados: ficam na raiz (ver core/paths.py), nunca dentro do pacote.
# Sem a barra inicial, o padrão casa em qualquer nível — protege contra um
# paths.py mal configurado voltar a despejar dados dentro de avariaia/.
logs/
resultados/
!resultados/README.md
!resultados/.gitkeep

database/
!database/.gitkeep
*.db
*.sqlite
*.sqlite3

imagens_para_analisar/*
!imagens_para_analisar/.gitkeep
!imagens_para_analisar/*.opus

imagens_processadas/*
!imagens_processadas/.gitkeep

# Proteção extra: dado gerado NUNCA deve viver dentro do pacote (avariaia/).
# Se um paths.py mal configurado voltar a apontar para lá, isto impede que
# imagens e resultados sejam commitados por engano.
avariaia/imagens_para_analisar/
avariaia/imagens_processadas/
avariaia/logs/
avariaia/resultados/
avariaia/database/

# Backups de relatórios
*.xlsx.bak
Relatorio_Backup_*.xlsx

# ============================================
# DESENVOLVIMENTO & TESTES
# ============================================

# Scripts de teste avulsos na raiz do projeto (NÃO a suíte de tests/ - sem
# a barra inicial, esses padrões batiam em qualquer tests/test_*.py também e
# apagavam a suíte inteira do controle de versão silenciosamente).
/test_*.py
/teste_*.py
/debug_*.py
/temp_*.py
debug.html
test.html

# ============================================
# DEPLOY & CONTAINERS
# ============================================

.vercel/
.netlify/
Procfile.dev
docker-compose.override.yml

# ============================================
# DEPENDÊNCIAS FRONTEND
# ============================================

node_modules/
*.min.js.map
*.min.css.map

# ============================================
# ARQUIVOS COMPACTADOS
# ============================================

*.zip
*.rar
*.7z
*.tar.gz
